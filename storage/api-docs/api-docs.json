        "/api/reminders/test-whatsapp": {
            "post": {
                "tags": [
                    "Reminders"
                ],
                "summary": "Test WhatsApp message delivery via Fonnte",
                "description": "Sends a test WhatsApp message to verify Fonnte gateway configuration",
                "operationId": "testWhatsAppMessage",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone_number"
                                ],
                                "properties": {
                                    "phone_number": {
                                        "type": "string",
                                        "example": "081234567890"
                                    },
                                    "message": {
                                        "type": "string",
                                        "example": "Halo! Ini adalah pesan pengujian WhatsApp dari NARA Assistant."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Message processed"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/reminders/trigger-morning": {
            "post": {
                "tags": [
                    "Reminders"
                ],
                "summary": "Manually trigger Morning Reminders",
                "description": "Triggers the 05:00 AM morning reminder for today's classes (or a specific overridden day)",
                "operationId": "triggerMorningReminder",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "dry_run": {
                                        "type": "boolean",
                                        "example": false
                                    },
                                    "day": {
                                        "type": "string",
                                        "example": "monday",
                                        "enum": [
                                            "monday",
                                            "tuesday",
                                            "wednesday",
                                            "thursday",
                                            "friday",
                                            "saturday",
                                            "sunday"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reminders triggered"
                    }
                }
            }
        },
        "/api/reminders/trigger-preclass": {
            "post": {
                "tags": [
                    "Reminders"
                ],
                "summary": "Manually trigger Pre-Class Reminders (H-1 Hour)",
                "description": "Triggers the 1-hour pre-class reminder check",
                "operationId": "triggerPreclassReminder",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "dry_run": {
                                        "type": "boolean",
                                        "example": false
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reminders triggered"
                    }
                }
            }
        },
        "/api/reminders/logs": {
            "get": {
                "tags": [
                    "Reminders"
                ],
                "summary": "Get reminder delivery logs",
                "description": "Returns delivery history and status of automated WhatsApp reminders",
                "operationId": "getReminderLogs",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "morning",
                                "pre_class"
                            ]
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "sent",
                                "failed",
                                "pending"
                            ]
                        }
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            }
        },
        "/api/schedules": {
            "get": {
                "tags": [
                    "Schedules"
                ],
                "summary": "Get list of academic schedules",
                "description": "Returns list of class schedules with filters for day, semester, and active status",
                "operationId": "getSchedulesList",
                "parameters": [
                    {
                        "name": "day",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "monday",
                                "tuesday",
                                "wednesday",
                                "thursday",
                                "friday",
                                "saturday",
                                "sunday"
                            ]
                        }
                    },
                    {
                        "name": "semester_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "is_active",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            },
            "post": {
                "tags": [
                    "Schedules"
                ],
                "summary": "Create new schedule",
                "description": "Creates a new academic class schedule",
                "operationId": "storeSchedule",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "course_id",
                                    "lecturer_id",
                                    "day",
                                    "start_time",
                                    "end_time"
                                ],
                                "properties": {
                                    "course_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "lecturer_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "course_pic_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "day": {
                                        "type": "string",
                                        "example": "monday",
                                        "enum": [
                                            "monday",
                                            "tuesday",
                                            "wednesday",
                                            "thursday",
                                            "friday",
                                            "saturday",
                                            "sunday"
                                        ]
                                    },
                                    "start_time": {
                                        "type": "string",
                                        "example": "07:00:00"
                                    },
                                    "end_time": {
                                        "type": "string",
                                        "example": "10:35:00"
                                    },
                                    "room": {
                                        "type": "string",
                                        "example": "RT-01"
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Schedule created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
